# GitHub language statistics (Linguist). This repository is a catalogue of
# Markdown skills; the Python is sample code and tooling around them.
# https://github.com/github-linguist/linguist/blob/main/docs/overrides.md

# Markdown is a prose language, which Linguist leaves out of the stats unless
# it is marked detectable.
*.md linguist-detectable

# Sample scripts and the checker: excluded from the stats.
resources/**/scripts/** linguist-vendored
*.py linguist-vendored
*.py -linguist-detectable

# Generated by sample-data/generate.py: collapsed in diffs, excluded from stats.
resources/**/sample-data/*.csv linguist-generated
